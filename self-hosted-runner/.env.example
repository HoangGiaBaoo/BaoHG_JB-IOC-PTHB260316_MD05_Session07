# Copy thành .env (đã có trong .gitignore, KHÔNG commit token lên GitHub)
REPO_URL=https://github.com/HoangGiaBaoo/BaoHG_JB-IOC-PTHB260316_MD05_Session07
RUNNER_NAME=quickbite-runner-01

# Chọn MỘT trong hai:
# a) Registration token: Settings > Actions > Runners > New self-hosted runner (dòng --token ...), hết hạn sau 1 giờ
RUNNER_TOKEN=
# b) Personal Access Token (classic) có scope `repo`
ACCESS_TOKEN=
